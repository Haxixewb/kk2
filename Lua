-- ========== TARGET PART RESOLVER ==========
local function resolveTargetPart(char)
    if not char then return nil end
    local mode = Config.TargetPart
    if mode == "Random" then
        local pool = { "Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart" }
        local pick = pool[math.random(1, #pool)]
        return char:FindFirstChild(pick) or char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild(mode) or char:FindFirstChild("HumanoidRootPart")
end

-- ========== VISIBILITY ==========
local function isVisible(part)
    if not Config.WallCheck then return true end
    local char = LocalPlayer.Character
    if not char then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, part.Parent }
    return Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params) == nil
end

-- ========== AIMBOT TARGET (OTIMIZADO) ==========
local function getClosestEnemy()
    if not Config.AimbotEnabled then return nil end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local candidates = {}

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character and pl.Character.Parent == Workspace then
            local isEnemy = true
            if pl.Team and LocalPlayer.Team and pl.Team == LocalPlayer.Team then
                isEnemy = false
            end
            if isEnemy then
                local char = pl.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = resolveTargetPart(char)
                    if part then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if dist <= Config.FOVRadius then
                                table.insert(candidates, {part = part, dist = dist})
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    for _, cand in ipairs(candidates) do
        if isVisible(cand.part) then
            return cand.part
        end
    end
    return nil
end

-- ========== MAIN LOOP (OTIMIZADO) ==========
RunService.RenderStepped:Connect(function(dt)
    FovCircle.Visible = Config.AimbotEnabled
    if Config.AimbotEnabled then
        FovCircle.Size = UDim2.new(0, Config.FOVRadius * 2, 0, Config.FOVRadius * 2)
        local targetPart = getClosestEnemy()
        local firing = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            or UserInputService:IsMouseButtonPressed(Enum.UserInputType.Touch)
        if targetPart and firing then
            local desired = CFrame.new(Camera.CFrame.Position, targetPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(Config.AimSmooth, 0.05, 1))
        end
    end

    for player, data in pairs(ESPElements) do
        local showESP = Config.ESPEnabled
        local char = player.Character
        
        local hrp = char and char.Parent == Workspace and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")

        local shouldHide = not showESP or not hrp or not hum or hum.Health <= 0 or not head
            or (player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team)

        local dist = 0
        if not shouldHide then
            dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > 300 then shouldHide = true end
        end

        if shouldHide then
            if data.container.Visible then data.container.Visible = false end
            if data.tracer.Visible then data.tracer.Visible = false end
        else
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)

            if onScreen and headOnScreen then
                local height = math.clamp(2000 / dist, 30, 200)
                local width = height * 0.6
                
                if not data.container.Visible then data.container.Visible = true end

                data.container.Size = UDim2.new(0, width, 0, height)
                data.container.Position = UDim2.new(0, pos.X - width / 2, 0, pos.Y - height / 2)
                data.box.Visible = Config.ESPBox

                for _, part in ipairs(data.parts) do part.BackgroundColor3 = Config.ESPColor end

                local textStr = ""
                if Config.ESPName then textStr = player.Name end
                if Config.ESPDistance then
                    if textStr ~= "" then textStr = textStr .. " | " end
                    textStr = textStr .. math.floor(dist) .. "m"
                end
                if data.lastText ~= textStr then
                    data.text.Text = textStr
                    data.lastText = textStr
                end
                data.text.Visible = (Config.ESPName or Config.ESPDistance)
                data.text.Size = UDim2.new(0, width * 2, 0, 20)
                data.text.Position = UDim2.new(0, -width / 2, 0, -22)

                if Config.ESPHealth then
                    data.healthBg.Visible = true
                    local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    data.healthFg.Size = UDim2.new(1, 0, pct, 0)
                    data.healthFg.Position = UDim2.new(0, 0, 1 - pct, 0)
                    data.healthFg.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0)
                else
                    data.healthBg.Visible = false
                end

                if Config.ESPTracer then
                    data.tracer.Visible = true
                    data.tracer.BackgroundColor3 = Config.ESPColor
                    local origin = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    local target = Vector2.new(pos.X, pos.Y + height / 2)
                    local delta = target - origin
                    local mid = (origin + target) / 2
                    data.tracer.Size = UDim2.new(0, delta.Magnitude, 0, 1)
                    data.tracer.Position = UDim2.new(0, mid.X, 0, mid.Y)
                    data.tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                else
                    if data.tracer.Visible then data.tracer.Visible = false end
                end
            else
                if data.container.Visible then data.container.Visible = false end
                if data.tracer.Visible then data.tracer.Visible = false end
            end
        end
    end
end)

-- ========== BYPASS MONITOR ==========
task.spawn(function()
    while task.wait(2) do
        local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        local speed = 0
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            speed = char.HumanoidRootPart.Velocity.Magnitude
        end
        if ping > 700 or speed > 250 then Config.BypassStatus = "BAN"
        elseif ping > 400 or speed > 150 then Config.BypassStatus = "RISK"
        else Config.BypassStatus = "SAFE" end
    end
end)

